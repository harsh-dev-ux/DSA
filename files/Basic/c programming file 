


################################################################
#  1) LINEAR SEARCH + BINARY SEARCH (ROLL NUMBERS)
################################################################

#include <stdio.h>
int linear(int a[],int n,int x){
    int i;
    for(i=0;i<n;i++)if(a[i]==x)return i;
    return -1;
}
int binary(int a[],int n,int x){
    int l=0,r=n-1,m;
    while(l<=r){
        m=(l+r)/2;
        if(a[m]==x)return m;
        if(a[m]<x)l=m+1;else r=m-1;
    }
    return -1;
}
int main(){
    int a[100],b[100],n,x,i;
    printf("Number of students: ");scanf("%d",&n);
    printf("Enter unsorted roll numbers: ");
    for(i=0;i<n;i++)scanf("%d",&a[i]);
    printf("Enter sorted roll numbers: ");
    for(i=0;i<n;i++)scanf("%d",&b[i]);
    printf("Roll number to search: ");scanf("%d",&x);
    printf("Linear Search: %s\n",linear(a,n,x)>=0?"Found":"Not Found");
    printf("Binary Search: %s\n",binary(b,n,x)>=0?"Found":"Not Found");
    return 0;
}


################################################################
#  2) SELECTION SORT + BUBBLE SORT (PERCENTAGES, TOP FIVE)
################################################################

#include <stdio.h>
int main(){
    float a[100],b[100],t;
    int n,i,j,m;
    printf("Number of students: ");scanf("%d",&n);
    printf("Enter percentages: ");
    for(i=0;i<n;i++)scanf("%f",&a[i]),b[i]=a[i];

    for(i=0;i<n-1;i++){
        m=i;
        for(j=i+1;j<n;j++)if(a[j]<a[m])m=j;
        t=a[i];a[i]=a[m];a[m]=t;
    }
    for(i=0;i<n-1;i++)
        for(j=0;j<n-i-1;j++)
            if(b[j]>b[j+1]){
                t=b[j];b[j]=b[j+1];b[j+1]=t;
            }

    printf("Selection Sort: ");
    for(i=0;i<n;i++)printf("%.2f ",a[i]);
    printf("\nBubble Sort: ");
    for(i=0;i<n;i++)printf("%.2f ",b[i]);
    printf("\nTop five scores: ");
    for(i=n-1;i>=0&&i>=n-5;i--)printf("%.2f ",b[i]);
    return 0;
}


################################################################
#  3) HASH TABLE TELEPHONE DIRECTORY (LINEAR / QUADRATIC / DOUBLE)
################################################################

#include <stdio.h>
#include <string.h>
#define S 101
char name[S][30];
long long phone[S];
int used[S],method;

int hash(char s[]){
    int h=0,i;
    for(i=0;s[i];i++)h=(h+s[i])%S;
    return h;
}
int pos(char s[],int i){
    int h=hash(s);
    if(method==1)return (h+i)%S;
    if(method==2)return (h+i*i)%S;
    return (h+i*(1+h%97))%S;
}
int main(){
    int c,i,j;char s[30];long long p;
    printf("1.Linear 2.Quadratic 3.Double Hashing: ");
    scanf("%d",&method);
    do{
        printf("\n1.Add 2.Search 3.Display 4.Exit: ");
        scanf("%d",&c);
        if(c==1){
            printf("Name and phone: ");scanf("%29s%lld",s,&p);
            for(i=0;i<S;i++){
                j=pos(s,i);
                if(used[j]&&!strcmp(name[j],s))break;
                if(!used[j])break;
            }
            if(i==S)printf("Table full\n");
            else{
                strcpy(name[j],s);phone[j]=p;used[j]=1;
                printf("Saved\n");
            }
        }
        if(c==2){
            printf("Client name: ");scanf("%29s",s);
            for(i=0;i<S;i++){
                j=pos(s,i);
                if(!used[j])break;
                if(!strcmp(name[j],s))break;
            }
            if(i<S&&used[j])printf("Phone: %lld\n",phone[j]);
            else printf("Not found\n");
        }
        if(c==3)
            for(i=0;i<S;i++)
                if(used[i])printf("%s: %lld\n",name[i],phone[i]);
    }while(c!=4);
    return 0;
}


################################################################
#  4) CLUB MEMBERS - SINGLY LINKED LIST
################################################################

#include <stdio.h>
#include <stdlib.h>
#include <string.h>
struct node{
    int prn;char name[30],role;
    struct node*next;
};
struct node*add(struct node*h,int p,char n[],char r){
    struct node*t=malloc(sizeof(*t)),*q;
    t->prn=p;strcpy(t->name,n);t->role=r;t->next=NULL;
    if(!h||r=='P'){t->next=h;return t;}
    if(r=='S'){
        q=h;while(q->next)q=q->next;q->next=t;return h;
    }
    q=h;
    while(q->next&&q->next->role!='S')q=q->next;
    t->next=q->next;q->next=t;return h;
}
struct node*del(struct node*h,int p){
    struct node*t=h,*q=NULL;
    while(t&&t->prn!=p)q=t,t=t->next;
    if(t){
        if(q)q->next=t->next;else h=t->next;
        free(t);
    }else printf("Member not found\n");
    return h;
}
void show(struct node*h){
    while(h){
        printf("%d %s (%c)\n",h->prn,h->name,h->role);
        h=h->next;
    }
}
int main(){
    struct node*a=NULL,*b=NULL,*t;
    int c,d,p,n;char name[30],r;
    do{
        printf("\n1.Add 2.Delete 3.Display 4.Count 5.Concatenate 6.Exit: ");
        scanf("%d",&c);
        if(c==1){
            printf("Division(1/2), PRN, name, role(P/M/S): ");
            scanf("%d%d%29s %c",&d,&p,name,&r);
            if(r!='P'&&r!='M'&&r!='S')printf("Invalid role\n");
            else if(d==1)a=add(a,p,name,r);
            else if(d==2)b=add(b,p,name,r);
        }
        if(c==2){
            printf("Division and PRN: ");scanf("%d%d",&d,&p);
            if(d==1)a=del(a,p);else if(d==2)b=del(b,p);
        }
        if(c==3){printf("Division 1:\n");show(a);printf("Division 2:\n");show(b);}
        if(c==4){
            n=0;for(t=a;t;t=t->next)n++;
            for(t=b;t;t=t->next)n++;
            printf("Total members: %d\n",n);
        }
        if(c==5){
            if(!a)a=b;
            else{t=a;while(t->next)t=t->next;t->next=b;}
            b=NULL;printf("Lists concatenated\n");
        }
    }while(c!=6);
    return 0;
}


################################################################
#  5) CINEMAX TICKET BOOKING - DOUBLY LINKED LIST
################################################################

#include <stdio.h>
#include <stdlib.h>
struct node{int s;struct node*p,*n;};
struct node*h[10];

void insert(int r,int s){
    struct node*t=malloc(sizeof(*t)),*q=h[r];
    t->s=s;t->p=t->n=NULL;
    if(!q||s<q->s){
        t->n=q;if(q)q->p=t;h[r]=t;return;
    }
    while(q->n&&q->n->s<s)q=q->n;
    t->n=q->n;t->p=q;
    if(q->n)q->n->p=t;
    q->n=t;
}
int removeSeat(int r,int s){
    struct node*t=h[r];
    while(t&&t->s!=s)t=t->n;
    if(!t)return 0;
    if(t->p)t->p->n=t->n;else h[r]=t->n;
    if(t->n)t->n->p=t->p;
    free(t);return 1;
}
int main(){
    int c,r,s,i;struct node*t;
    for(i=0;i<10;i++)for(s=1;s<=7;s++)insert(i,s);
    do{
        printf("\n1.Available 2.Book 3.Cancel 4.Exit: ");
        scanf("%d",&c);
        if(c>=1&&c<=3){
            printf("Row(1-10): ");scanf("%d",&r);
            if(r<1||r>10){printf("Invalid row\n");continue;}
            r--;
            if(c==1){
                printf("Available seats: ");
                for(t=h[r];t;t=t->n)printf("%d ",t->s);
                printf("\n");
            }else{
                printf("Seat(1-7): ");scanf("%d",&s);
                if(s<1||s>7){printf("Invalid seat\n");continue;}
                if(c==2)
                    printf(removeSeat(r,s)?"Booking successful\n":"Seat unavailable\n");
                else{
                    for(t=h[r];t&&t->s!=s;t=t->n);
                    if(t)printf("Seat already available\n");
                    else insert(r,s),printf("Cancellation successful\n");
                }
            }
        }
    }while(c!=4);
    return 0;
}


################################################################
#  6) INFIX TO POSTFIX + EVALUATION (STACK)
################################################################

#include <stdio.h>
#include <ctype.h>
#include <math.h>
char st[100];int top=-1;

int prec(char c){
    if(c=='^')return 3;
    if(c=='*'||c=='/')return 2;
    if(c=='+'||c=='-')return 1;
    return 0;
}
int main(){
    char s[100],p[100];int i,j=0,a[100],k=-1,x,y;
    printf("Infix: ");scanf("%99s",s);
    for(i=0;s[i];i++){
        char c=s[i];
        if(c==',')continue;
        if(isdigit(c))p[j++]=c;
        else if(c=='(')st[++top]=c;
        else if(c==')'){
            while(top>=0&&st[top]!='(')p[j++]=st[top--];
            if(top>=0)top--;
        }else{
            while(top>=0&&st[top]!='('&&
            (prec(st[top])>prec(c)||
            (prec(st[top])==prec(c)&&c!='^')))
                p[j++]=st[top--];
            st[++top]=c;
        }
    }
    while(top>=0)p[j++]=st[top--];
    p[j]='\0';
    printf("Postfix: %s\n",p);

    for(i=0;p[i];i++){
        if(isdigit(p[i]))a[++k]=p[i]-'0';
        else{
            y=a[k--];x=a[k--];
            switch(p[i]){
                case '+':a[++k]=x+y;break;
                case '-':a[++k]=x-y;break;
                case '*':a[++k]=x*y;break;
                case '/':a[++k]=x/y;break;
                case '^':a[++k]=(int)pow(x,y);break;
            }
        }
    }
    printf("Result: %d\n",a[k]);
    return 0;
}


################################################################
#  7) PIZZA PARLOR JOB QUEUE - CIRCULAR QUEUE
################################################################

#include <stdio.h>
#define M 5
int q[M],f=-1,r=-1;

void enqueue(int x){
    if((r+1)%M==f)printf("Queue full\n");
    else{
        if(f==-1)f=0;
        r=(r+1)%M;q[r]=x;
        printf("Order added\n");
    }
}
void dequeue(){
    if(f==-1)printf("Queue empty\n");
    else{
        printf("Order served: %d\n",q[f]);
        if(f==r)f=r=-1;
        else f=(f+1)%M;
    }
}
void display(){
    int i;
    if(f==-1){printf("Queue empty\n");return;}
    for(i=f;;i=(i+1)%M){
        printf("%d ",q[i]);
        if(i==r)break;
    }
    printf("\n");
}
int main(){
    int c,x;
    do{
        printf("\n1.Enqueue 2.Dequeue 3.Display 4.Exit: ");
        scanf("%d",&c);
        if(c==1){printf("Order ID: ");scanf("%d",&x);enqueue(x);}
        if(c==2)dequeue();
        if(c==3)display();
    }while(c!=4);
    return 0;
}


################################################################
#  8) BINARY SEARCH TREE (INSERT, HEIGHT, MIN, MIRROR, SEARCH)
################################################################

#include <stdio.h>
#include <stdlib.h>
struct node{int d;struct node*l,*r;};

struct node*add(struct node*t,int x){
    if(!t){
        t=malloc(sizeof(*t));
        t->d=x;t->l=t->r=NULL;
    }else if(x<t->d)t->l=add(t->l,x);
    else t->r=add(t->r,x);
    return t;
}
int height(struct node*t){
    int a,b;
    if(!t)return 0;
    a=height(t->l);b=height(t->r);
    return 1+(a>b?a:b);
}
void mirror(struct node*t){
    struct node*p;
    if(t){
        p=t->l;t->l=t->r;t->r=p;
        mirror(t->l);mirror(t->r);
    }
}
int search(struct node*t,int x){
    if(!t)return 0;
    if(t->d==x)return 1;
    return search(t->l,x)||search(t->r,x);
}
int minimum(struct node*t){
    int m;
    if(!t->l&&!t->r)return t->d;
    m=t->d;
    if(t->l){int x=minimum(t->l);if(x<m)m=x;}
    if(t->r){int x=minimum(t->r);if(x<m)m=x;}
    return m;
}
void display(struct node*t){
    if(t){display(t->l);printf("%d ",t->d);display(t->r);}
}
int main(){
    struct node*t=NULL;int c,x;
    do{
        printf("\n1.Insert 2.Height 3.Minimum 4.Mirror 5.Search 6.Display 7.Exit: ");
        scanf("%d",&c);
        if(c==1){printf("Value: ");scanf("%d",&x);t=add(t,x);}
        if(c==2)printf("Height: %d\n",height(t));
        if(c==3){
            if(t)printf("Minimum: %d\n",minimum(t));
            else printf("Tree empty\n");
        }
        if(c==4)mirror(t),printf("Tree mirrored\n");
        if(c==5){
            printf("Search value: ");scanf("%d",&x);
            printf(search(t,x)?"Found\n":"Not found\n");
        }
        if(c==6)display(t),printf("\n");
    }while(c!=7);
    return 0;
}


################################################################
#  9) FLIGHT GRAPH - COST MATRIX + CONNECTIVITY CHECK (BFS)
################################################################

#include <stdio.h>
#define N 20
int a[N][N],v[N],q[N];
int main(){
    int n,e,x,y,w,i,j,c,f,r,count;
    printf("Number of cities and flights: ");
    scanf("%d%d",&n,&e);
    if(n<1||n>N||e<0)return 0;

    for(i=0;i<e;i++){
        printf("From To Cost: ");
        scanf("%d%d%d",&x,&y,&w);
        if(x>=0&&x<n&&y>=0&&y<n&&x!=y&&w>0)
            a[x][y]=a[y][x]=w;
    }
    do{
        printf("\n1.Display graph 2.Check connectivity 3.Exit: ");
        scanf("%d",&c);
        if(c==1){
            printf("Cost matrix (0 = no flight):\n");
            for(i=0;i<n;i++){
                for(j=0;j<n;j++)printf("%d ",a[i][j]);
                printf("\n");
            }
        }
        if(c==2){
            for(i=0;i<n;i++)v[i]=0;
            f=0;r=0;count=0;
            q[r]=0;v[0]=1;
            while(f<=r){
                x=q[f++];count++;
                for(y=0;y<n;y++)
                    if(a[x][y]>0&&!v[y]){
                        v[y]=1;q[++r]=y;
                    }
            }
            printf("%s\n",count==n?"Connected":"Not connected");
        }
    }while(c!=3);
    return 0;
}
